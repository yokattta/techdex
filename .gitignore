# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# This folder collects unrelated projects, each with its own git repo, and they
# keep appearing. Listing them one by one lost that race once already, so:
# ignore every top-level directory by default and opt this project's own back
# in. A new sibling can no longer be swept into a commit.
# Adding a real top-level directory to this project means adding a line here.
/*/
!/app/
!/components/
!/lib/
!/public/
!/scripts/
!/.github/
!/.claude/

# Per-machine Claude Code settings. launch.json is ignored too: every session
# in this folder appends its own dev-server entry, so the file accumulates the
# names and paths of unrelated projects — which then sit in a public repo.
# `npm run dev` is documented in the README; nothing is lost by not shipping it.
.claude/settings.local.json
.claude/launch.json

# static export output
/out/
